{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ElevenLabs Dialogue Manifest",
  "description": "A single chunk ready for ElevenLabs v3 Text-to-Dialogue API. Compiled from Director Script JSONL.",
  "type": "object",
  "required": ["chunk_id", "model_id", "api_endpoint", "inputs"],
  "properties": {
    "chunk_id": {
      "type": "string",
      "pattern": "^C\\d{2}$",
      "description": "Matches chunk_id in Director Script"
    },
    "model_id": {
      "type": "string",
      "enum": ["eleven_v3", "eleven_multilingual_v2", "eleven_flash_v2_5"],
      "default": "eleven_v3",
      "description": "ElevenLabs model ID. v3 required for audio tags."
    },
    "api_endpoint": {
      "type": "string",
      "enum": [
        "POST /v1/text-to-dialogue",
        "POST /v1/text-to-dialogue/stream",
        "POST /v1/text-to-speech/{voice_id}"
      ],
      "default": "POST /v1/text-to-dialogue",
      "description": "API endpoint to use for this chunk"
    },
    "settings": {
      "type": "object",
      "properties": {
        "stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0=creative, 0.5=natural, 1=robust"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "description": "Ordered list of dialogue turns. Total text across all inputs must be ≤2000 chars.",
      "items": {
        "type": "object",
        "required": ["text", "voice_id"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 10,
            "description": "Spoken text with optional audio tags prefix"
          },
          "voice_id": {
            "type": "string",
            "description": "ElevenLabs voice ID"
          }
        },
        "additionalProperties": false
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "Optional seed for deterministic generation"
    },
    "output_format": {
      "type": "string",
      "default": "mp3_44100_128",
      "description": "Audio output format (e.g., mp3_44100_128, mp3_44100_192, wav)"
    }
  },
  "additionalProperties": false
}
